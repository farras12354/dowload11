{
  "functions": {
    "api/download.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/downloader/:endpoint",
      "destination": "/api/downloader/[endpoint]?endpoint=:endpoint"
    },
    {
      "source": "/api/download",
      "destination": "/api/download"
    },
    {
      "source": "/dl",
      "destination": "/api/download"
    },
    {
      "source": "/dl.php",
      "destination": "/api/download"
    }
  ]
}
